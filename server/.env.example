# Server environment - copy to server/.env and fill in real values.
# NEVER commit server/.env or real credentials.

# Port the API listens on (Render supplies this automatically).
PORT=5001

# MongoDB connection string (local or MongoDB Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/jira-clone

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Token lifetime.
JWT_EXPIRES_IN=7d

# Origin of the deployed frontend (used for CORS). No trailing slash.
CLIENT_URL=http://localhost:5173
